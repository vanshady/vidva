{
	# TLS is terminated upstream (reverse proxy) if at all.
	auto_https off
}

# PLEX_SERVER_URL and PLEX_TOKEN come from the container env (see env.sh).
(plex_upstream) {
	reverse_proxy {$PLEX_SERVER_URL} {
		header_up Host {upstream_hostport}
		header_up X-Plex-Token {$PLEX_TOKEN}
	}
}

:5173 {
	root * /app/dist
	encode zstd gzip

	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000;"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Build output. Filenames are content-hashed, but env.sh rewrites the .js/.css
	# files with this container's Plex settings at startup, so those must
	# revalidate (cheap 304 via ETag). Fonts and images never change.
	# No SPA fallback here: a missing chunk should 404, not return index.html.
	handle /assets/* {
		@mutable path *.js *.css
		header @mutable Cache-Control "no-cache"
		@immutable not path *.js *.css
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Plex API and images. The browser calls /plex/...; the token is added here,
	# server-side, so it never reaches the bundle. Only the exact read-only
	# request shapes the dashboard makes are forwarded; everything else
	# (server settings, account data, scans/refreshes, writes) gets 403.
	handle /plex/* {
		@library {
			method GET HEAD
			path_regexp ^/plex/library/(sections|sections/[0-9]+/all|metadata/[0-9]+(,[0-9]+)*|metadata/[0-9]+/thumb/[0-9]+)$
		}
		handle @library {
			uri strip_prefix /plex
			import plex_upstream
		}

		# Resized artwork. Plex's transcoder fetches whatever `url` names (remote
		# URLs included), so the request is rebuilt from validated parts and `url`
		# can only be a library thumbnail.
		@artwork {
			method GET HEAD
			path /plex/photo/:/transcode
			expression `{query.url}.matches('^/library/metadata/[0-9]+/thumb/[0-9]+$') && {query.width}.matches('^[0-9]{1,4}$') && {query.height}.matches('^[0-9]{1,4}$')`
		}
		handle @artwork {
			rewrite * /photo/:/transcode?width={query.width}&height={query.height}&minSize=1&upscale=1&url={query.url}
			import plex_upstream
		}

		handle {
			respond 403
		}
	}

	# Everything else: real files (logo, etc.) or the SPA shell for client routes.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
