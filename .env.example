# Local development (`npm run dev` / `npm run preview`).
#
# Server-side only: Vite's dev server proxies /plex/* to this server and adds the
# token. Keep these WITHOUT the VITE_ prefix so they never reach browser code.
PLEX_SERVER_URL=http://your-plex-server:32400
PLEX_TOKEN=your-plex-token

# Exposed to the browser (not secret).
# Go to <PLEX_SERVER_URL>/identity and copy machineIdentifier
VITE_PLEX_SERVER_ID=your-server-id
# all, 3 (Plex default), 4 (Letterboxd default), 5 or 10
VITE_DEFAULT_TOP_CAST_COUNT=4
